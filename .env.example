# Copie este arquivo para .env e preencha os valores.
# No Google AI Studio / Cloud Run, configure as mesmas variáveis no painel Secrets.

# Conexão PostgreSQL (ex.: Neon). Obrigatória em produção, pois o disco do Cloud Run é apagado a cada reinício.
# Sem ela, o servidor usa SQLite local no arquivo agendaflex.db.
# Formato: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=""

# E-mails Google autorizados a entrar, separados por vírgula.
# Vazio = qualquer conta Google autenticada entra (use só em desenvolvimento).
ALLOWED_EMAILS=""

# URL pública do app (o AI Studio preenche automaticamente)
APP_URL=""
